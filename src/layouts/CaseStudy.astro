---
import Base from './Base.astro';
import Divider from '../components/patterns/Divider.astro';
import { getBuildLogSeries } from '../lib/series';

interface Props {
  title: string;
  projectName?: string;
  summary: string;
  date: Date;
  stack: string[];
  tags: string[];
  github?: string;
  demo?: string;
  project?: string;
}

const { title, projectName, summary, date, stack, tags, github, demo, project } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const buildLogs = project ? (await getBuildLogSeries(project)).logs : [];

// Split title into project name + tagline if colon is present
const colonIdx = title.indexOf(': ');
const displayName = projectName ?? (colonIdx !== -1 ? title.slice(0, colonIdx) : title);
const tagline = colonIdx !== -1 ? title.slice(colonIdx + 2) : null;
---
<Base title={displayName} description={summary}>
  <main class="max-w-4xl mx-auto px-6 py-8 sm:py-12">
    <div class="mb-10">
      <div class="flex items-center gap-2 text-sm text-ink-muted mb-4">
        <a href="/blog" class="hover:text-forest-light transition-colors">Blog</a>
        <span>›</span>
        <span class="text-forest-light font-medium">Case Study</span>
      </div>
      <h1 class="text-4xl font-heading font-bold text-ink leading-tight mb-2">{displayName}</h1>
      {tagline && (
        <p class="text-lg text-ink-muted font-medium mb-4">{tagline}</p>
      )}
      <p class="text-xl text-ink-muted leading-relaxed">{summary}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-12 items-start">
      <article class="prose-portfolio">
        <slot />
      </article>

      <aside class="lg:sticky lg:top-24">
        <div class="bg-bg-surface border border-border-subtle rounded-xl p-5 space-y-5">
          <div>
            <p class="text-xs font-semibold text-ink-muted uppercase tracking-widest mb-1.5">Published</p>
            <p class="text-sm text-ink">{formattedDate}</p>
          </div>

          {stack.length > 0 && (
            <div>
              <p class="text-xs font-semibold text-ink-muted uppercase tracking-widest mb-2">Stack</p>
              <div class="flex flex-wrap gap-1.5">
                {stack.map(s => (
                  <span class="text-xs bg-forest/10 text-forest-light px-2 py-0.5 rounded-full font-medium">{s}</span>
                ))}
              </div>
            </div>
          )}

          {tags.length > 0 && (
            <div>
              <p class="text-xs font-semibold text-ink-muted uppercase tracking-widest mb-2">Tags</p>
              <div class="flex flex-wrap gap-2">
                {tags.map(t => (
                  <a href={`/blog?tag=${t}`} class="text-xs text-ink-muted hover:text-forest-light transition-colors">#{t}</a>
                ))}
              </div>
            </div>
          )}

          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-ink-muted hover:text-forest-light transition-colors"
            >
              <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          )}

          {demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm font-medium text-forest-light hover:text-forest transition-colors"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              Live Demo
            </a>
          )}
        </div>
      </aside>
    </div>

    {buildLogs.length > 0 && (
      <div class="mt-14 max-w-2xl">
        <Divider color="brown" class="mb-10" />
        <h2 class="text-xs font-semibold uppercase tracking-widest text-brown-light mb-6">
          Build logs from this project
        </h2>
        <ol class="space-y-5">
          {buildLogs.map(log => (
            <li class="border-l-2 border-brown pl-4">
              <a href={`/blog/${log.id}`} class="group block">
                <time class="text-xs font-mono text-ink-muted block mb-1">
                  {log.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <p class="text-ink font-medium group-hover:text-brown-light transition-colors">{log.data.title}</p>
                <p class="text-sm text-ink-muted">{log.data.summary}</p>
              </a>
            </li>
          ))}
        </ol>
      </div>
    )}
  </main>
</Base>
