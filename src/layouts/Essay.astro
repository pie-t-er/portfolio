---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  tags: string[];
  summary: string;
}

const { title, date, tags, summary } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base title={title} description={summary}>
  <main class="max-w-2xl mx-auto px-6 py-8 sm:py-12">
    <div class="flex items-center gap-2 text-sm text-ink-muted mb-6">
      <a href="/blog" class="hover:text-purple-light transition-colors">Blog</a>
      <span>›</span>
      <a href="/blog?type=essay" class="text-purple-light font-medium hover:text-purple transition-colors">Essays</a>
    </div>

    <div class="mb-10">
      <time class="text-xs font-mono text-ink-muted block mb-3">{formattedDate}</time>
      <h1 class="text-3xl font-heading font-bold text-ink mb-4 leading-tight">{title}</h1>
      <p class="text-ink-muted text-lg leading-relaxed">{summary}</p>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map(t => (
            <span class="text-xs text-ink-muted">#{t}</span>
          ))}
        </div>
      )}
    </div>

    <article class="prose-portfolio">
      <slot />
    </article>

    <div class="mt-12 pt-6 border-t border-border-subtle">
      <a href="/blog?type=essay" class="text-sm text-purple-light hover:text-purple transition-colors">
        ← All essays
      </a>
    </div>
  </main>
</Base>
