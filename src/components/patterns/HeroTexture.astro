---
interface Props {
  opacity?: number;
}

const { opacity = 0.04 } = Astro.props;
const patternId = `hero-texture-${Math.random().toString(36).slice(2, 8)}`;
---

<!-- Requires the parent element to have class="relative" (and ideally overflow-hidden) -->
<div class="absolute inset-0 pointer-events-none" style={`opacity:${opacity}`} aria-hidden="true">
  <svg width="100%" height="100%">
    <pattern id={patternId} width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M0 16 L16 0 L32 16 L16 32 Z" fill="none" stroke="#f0ece3" stroke-width="0.5" />
    </pattern>
    <rect width="100%" height="100%" fill={`url(#${patternId})`} />
  </svg>
</div>