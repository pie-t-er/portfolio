---
interface Props {
  color?: 'forest' | 'brown' | 'purple' | 'navy';
  position?: 'top-left' | 'top-right';
}

const { color = 'forest', position = 'top-right' } = Astro.props;

const STROKE: Record<string, string> = {
  forest: '#74c69d',
  brown: '#c9956a',
  purple: '#a78bcc',
  navy: '#6aa3d4',
};

const posClass = position === 'top-left' ? 'left-0 top-0' : 'right-0 top-0 -scale-x-100';
---

<!-- Requires the parent element to have class="relative" -->
<svg class={`absolute ${posClass} w-5 h-5 pointer-events-none`} viewBox="0 0 20 20" aria-hidden="true">
  <path d="M0 0 L20 0 L20 6 L6 6 L6 20 L0 20 Z" fill="none" stroke={STROKE[color]} stroke-width="1" opacity="0.7" />
</svg>