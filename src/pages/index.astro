---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SkillBars from '../components/SkillBars.jsx';
import HeroTexture from '../components/patterns/HeroTexture.astro';
import Divider from '../components/patterns/Divider.astro';
import { SKILL_GROUPS } from '../data/skills';
import { ACTIVE_BUILDS } from '../data/activeBuilds';
import { LIVE_DEPLOYMENTS } from '../data/liveDeployments';

const allPosts = await getCollection('blog');

const caseStudies = allPosts
  .filter(p => p.data.type === 'case-study')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const buildLogs = allPosts
  .filter(p => p.data.type === 'build-log')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Active builds: pair each config entry with its recent build log entries
const activeBuilds = ACTIVE_BUILDS.map(build => ({
  ...build,
  recentLogs: buildLogs
    .filter(p => p.data.project === build.id)
    .slice(0, 3),
}));

// Skill bars: only case studies, only skills with ≥1 project
const skillGroups = SKILL_GROUPS
  .map(group => ({
    category: group.category,
    skills: group.skills
      .map(skillName => ({
        name: skillName,
        projects: caseStudies
          .filter(p => p.data.stack.some(s => s.toLowerCase() === skillName.toLowerCase()))
          .map(p => ({ id: p.id, title: p.data.title, projectName: p.data.projectName ?? null, summary: p.data.summary })),
      }))
      .filter(s => s.projects.length > 1),
  }))
  .filter(g => g.skills.length > 0);

const recentWork = caseStudies.slice(0, 3);
---
<Base title="Home" description="Pieter Alley — software engineer, builder, writer." noFooter hideMobileNav>
  <main>

    <!-- Mobile dock: full-viewport link screen, hidden on sm+ -->
    <section class="sm:hidden min-h-[100dvh] flex flex-col items-center justify-center px-6 py-10 text-center">
      <p class="text-forest-light font-mono text-sm mb-3 tracking-wide">Hello, I'm</p>
      <h1 class="text-4xl font-heading font-bold mb-10 leading-tight">Pieter Alley</h1>
      <nav class="w-full max-w-xs flex flex-col gap-2 mb-2">
        <a href="/blog" class="flex items-center justify-between px-4 py-3 rounded-lg border border-border-subtle text-base text-ink hover:text-forest-light hover:border-forest/40 transition-colors">
          <span>Blog</span>
        </a>
        <a href="/about" class="flex items-center justify-between px-4 py-3 rounded-lg border border-border-subtle text-base text-ink-muted hover:text-forest-light hover:border-forest/40 transition-colors">
          <span>About</span>
        </a>
        <a href="/work-with-me" class="flex items-center justify-between px-4 py-3 rounded-lg border border-border-subtle text-base text-ink-muted hover:text-forest-light hover:border-forest/40 transition-colors">
          <span>Let's Build</span>
        </a>
        <a href="/assets/Resume.pdf" target="_blank" rel="noopener noreferrer"
           class="flex items-center justify-between px-4 py-3 rounded-lg border border-border-subtle text-base text-ink-muted hover:text-forest-light hover:border-forest/40 transition-colors">
          <span>Résumé</span>
        </a>
      </nav>
      <div class="w-full max-w-xs mb-10">
        <div class="flex flex-col gap-2">
          {LIVE_DEPLOYMENTS.map(d => (
            <a href={d.url} target="_blank" rel="noopener noreferrer"
               class="flex items-center justify-between px-4 py-3 rounded-lg border border-border-subtle text-base text-ink-muted hover:text-forest-light hover:border-forest/40 transition-colors">
              <span>{d.name}</span>
              <span class="text-xs">↗</span>
            </a>
          ))}
        </div>
      </div>
      <SocialLinks class="flex items-center gap-6" iconSize="w-6 h-6" />
    </section>

    <!-- Desktop homepage: hidden on mobile -->
    <div class="hidden sm:block">

    <!-- Hero -->
    <section class="relative bg-bg text-ink overflow-hidden">
      <HeroTexture opacity={0.05} />
      <div class="relative max-w-4xl mx-auto px-6 flex items-end gap-8">
        <!-- Text -->
        <div class="flex-1 min-w-0 py-28">
          <p class="text-forest-light font-mono text-sm mb-4 tracking-wide">Hello, I'm</p>
          <h1 class="text-5xl sm:text-6xl font-heading font-bold mb-5 leading-tight">Pieter Alley</h1>
          <p class="text-xl text-ink-muted mb-10 max-w-lg leading-relaxed">
            Software engineer who builds things carefully, documents the process, and cares about craft.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/blog" class="bg-forest text-ink px-6 py-3 rounded-lg font-medium hover:bg-forest/90 transition-colors">
              Read the Blog
            </a>
            <a href="/work-with-me" class="border border-border-subtle text-ink px-6 py-3 rounded-lg font-medium hover:border-ink-muted transition-colors">
              Let's Build Something
            </a>
          </div>
        </div>
        <!-- Headshot -->
        <div class="hidden sm:block shrink-0 self-end">
          <img
            src="/headshot/DSC09519.png"
            alt="Pieter Alley"
            class="block h-[480px] w-auto select-none pointer-events-none"
            draggable="false"
          />
        </div>
      </div>
    </section>

    <!-- Bio strip -->
    <section class="border-b border-border-subtle bg-bg-surface">
      <div class="max-w-4xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <p class="text-ink-muted leading-relaxed max-w-xl">
          I'm a CS graduate from the University of Florida. I studied abroad in Ghana, spent summers as a camp counselor in Virginia, and build software that solves problems I've actually felt.
        </p>
        <a href="/about" class="text-sm font-medium text-forest-light hover:text-forest transition-colors shrink-0 whitespace-nowrap">
          More about me →
        </a>
      </div>
    </section>

    <!-- Active Builds -->
    {activeBuilds.length > 0 && (
      <section class="border-b border-border-subtle bg-bg-surface">
        <div class="max-w-4xl mx-auto px-6 py-12">
          <div class="flex items-baseline gap-3 mb-8">
            <h2 class="text-lg font-heading font-bold text-ink">Active Builds</h2>
            <span class="inline-flex items-center gap-1.5 text-xs text-brown-light font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-brown-light animate-pulse"></span>
              In progress
            </span>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            {activeBuilds.map(build => (
              <div class="border border-border-subtle rounded-xl p-5 hover:border-brown/50 transition-colors">
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div>
                    <h3 class="font-semibold text-ink">{build.name}</h3>
                    <p class="text-sm text-ink-muted mt-0.5">{build.description}</p>
                  </div>
                  {build.github && (
                    <a href={build.github} target="_blank" rel="noopener noreferrer"
                       class="text-ink-muted hover:text-brown-light transition-colors shrink-0 mt-0.5"
                       aria-label="GitHub">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                </div>

                {build.recentLogs.length > 0 ? (
                  <div class="space-y-2 border-t border-border-subtle pt-3 mt-3">
                    {build.recentLogs.map(log => (
                      <a href={`/blog/${log.id}`}
                         class="group flex items-start gap-3 text-sm hover:text-brown-light transition-colors">
                        <time class="text-xs font-mono text-ink-muted shrink-0 pt-0.5 w-16">
                          {log.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                        </time>
                        <span class="text-ink-muted group-hover:text-brown-light transition-colors line-clamp-1">
                          {log.data.title}
                        </span>
                      </a>
                    ))}
                    <a href={`/blog?type=build-log`}
                       class="flex items-center gap-1 text-xs text-brown-light hover:text-brown transition-colors pt-1">
                      Full build log →
                    </a>
                  </div>
                ) : (
                  <p class="text-xs text-ink-muted border-t border-border-subtle pt-3 mt-3">No log entries yet.</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Live Deployments -->
    <section class="border-b border-border-subtle bg-bg-surface">
      <div class="max-w-4xl mx-auto px-6 py-12">
        <div class="flex items-baseline gap-3 mb-8">
          <h2 class="text-lg font-heading font-bold text-ink">Live</h2>
          <span class="inline-flex items-center gap-1.5 text-xs text-forest-light font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-forest-light animate-pulse"></span>
            Deployed
          </span>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          {LIVE_DEPLOYMENTS.map(d => (
            <div class="border border-border-subtle rounded-xl p-5 flex flex-col gap-3 hover:border-forest/40 transition-colors">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-semibold text-ink">{d.name}</h3>
                <a href={d.url} target="_blank" rel="noopener noreferrer"
                   class="text-ink-muted hover:text-forest-light transition-colors shrink-0 mt-0.5"
                   aria-label={`View ${d.name} live`}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
              <p class="text-sm text-ink-muted leading-relaxed flex-1">{d.description}</p>
              {d.caseStudy && (
                <a href={`/blog/${d.caseStudy}`}
                   class="text-xs text-forest-light hover:text-forest transition-colors">
                  Read case study →
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Recent case studies -->
    <section class="max-w-4xl mx-auto px-6 py-16">
      <div class="flex justify-between items-baseline mb-8">
        <h2 class="text-2xl font-heading font-bold text-ink">Recent Work</h2>
        <a href="/blog?type=case-study" class="text-sm text-forest-light hover:text-forest transition-colors">
          All case studies →
        </a>
      </div>
      <div class="grid gap-4">
        {recentWork.map(post => (
          <a href={`/blog/${post.id}`}
             class="group block p-6 rounded-xl border border-border-subtle hover:border-forest/40 hover:shadow-sm transition-all">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-bold text-ink group-hover:text-forest-light transition-colors">
                {post.data.title}
              </h3>
              <time class="text-xs text-ink-muted shrink-0 ml-4">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
              </time>
            </div>
            <p class="text-sm text-ink-muted leading-relaxed">{post.data.summary}</p>
            {post.data.stack.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-3">
                {post.data.stack.map(s => (
                  <span class="text-xs bg-bg-surface-2 text-ink-muted px-2 py-0.5 rounded-full">{s}</span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </section>

    <Divider color="forest" class="max-w-4xl mx-auto opacity-70" />

    <!-- Skill bars -->
    <section id="skills-section" class="bg-black relative z-20">
      <div class="max-w-4xl mx-auto px-6 py-16">
        <div class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-1">Skills</h2>
          <p class="text-sm text-neutral-500">Each panel is a project, click to read the case study.</p>
        </div>
        <SkillBars skillGroups={skillGroups} client:visible />
      </div>
      <!-- AI attribution — true page bottom, visible when fully scrolled -->
      <div class="border-t border-slate-800 pb-8 pt-6 text-center" style="padding-bottom: calc(2rem + 130px);">
        <p class="text-xs text-slate-600 leading-relaxed max-w-4xl mx-auto px-6">
          The majority of this site was generated with
          <a href="https://claude.ai/code" target="_blank" rel="noopener noreferrer"
             class="hover:text-slate-400 transition-colors underline underline-offset-2">Claude Code</a>,
          an agentic AI coding tool by Anthropic, with human review and direction.
        </p>
      </div>
    </section>

    </div>{/* end desktop-only wrapper */}

  </main>

  <!-- Footer: fixed off-screen, revealed by IntersectionObserver when skills section enters view -->
  <div id="home-footer" class="hidden sm:block fixed bottom-0 inset-x-0 z-30 translate-y-full transition-transform duration-500 ease-out">
    <Footer />
  </div>
</Base>

<script>
  const footer  = document.getElementById('home-footer');
  const skills  = document.getElementById('skills-section');

  const obs = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      // Skills section has entered the viewport — slide footer up
      footer.classList.remove('translate-y-full');
    } else if (entry.boundingClientRect.top > 0) {
      // Skills section is still below the viewport — keep footer hidden
      footer.classList.add('translate-y-full');
    }
    // If top ≤ 0 the section has scrolled above — footer stays visible
  }, { threshold: 0 });

  obs.observe(skills);
</script>
