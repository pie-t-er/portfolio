---
import Base from '../layouts/Base.astro';
---
<Base title="Message sent" description="Thanks for reaching out.">
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center">
    <div class="text-4xl mb-6">✉️</div>
    <h1 class="text-3xl font-heading font-bold text-ink mb-10">Got it, thanks.</h1>
    <a href="/" class="text-sm text-forest-light hover:text-forest transition-colors">
      ← Back home
    </a>
  </main>
</Base>
